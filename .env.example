# Concierge Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Property and operator identity
# ============================================================
# Used in guest-facing email signatures and provider outreach.

HOTEL_NAME="Your Hotel"
OPERATOR_NAME="Your Name"

# ============================================================
# Email accounts — guest-facing vs B2B
# ============================================================
# Concierge work splits cleanly into two streams:
#   - Guest communications (always to the guest's mailbox of record)
#   - B2B (provider) communications — restaurants, drivers, chefs, vendors
# Use SEPARATE outbound addresses so you never accidentally
# email a guest from your supplier inbox.

INBOX_GUEST_HOTEL="stays@yourhotel.com"      # Hotel-room guests
INBOX_GUEST_RENTAL="rental@yourhotel.com"    # Whole-property renters
INBOX_PROVIDERS="suppliers@yourhotel.com"    # B2B — restaurants, drivers, chefs

EMAIL_CLI="gws gmail"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent uses these tools to look up reservations and
# append concierge notes. Replace with whatever your PMS exposes.
# Reference setup uses Cloudbeds.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"
PMS_NOTES_TOOL="tools/cloudbeds_notes.py"

# ============================================================
# Concierge tracker
# ============================================================
# Where you log services-on-behalf-of-guests (restaurant
# reservations, transfers, tours, activities). Reference
# setup uses a Google Sheet, but any tracker works.

SHEET_ID_CONCIERGE=""

# ============================================================
# Optional Cloudbeds reference values
# ============================================================
# Only needed if you use the Cloudbeds PMS for the lookup/notes
# tools above.

# CLOUDBEDS_CLIENT_ID=""
# CLOUDBEDS_CLIENT_SECRET=""
# CLOUDBEDS_ACCESS_TOKEN=""
# CLOUDBEDS_REFRESH_TOKEN=""
